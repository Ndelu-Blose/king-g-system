# --- API (server / king-g-api on Vercel) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Same anon/publishable key as the frontend (for Auth sign-in on the API)
SUPABASE_ANON_KEY=your_supabase_anon_key
JWT_SECRET=change_me_in_production

# --- Frontend (king-g-system on Vercel) ---
# Production: set VITE_API_URL to your API host (baked in at build time)
# VITE_API_URL=https://king-g-api.vercel.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Local dev: omit VITE_API_URL so Vite proxies /api → http://localhost:3001
