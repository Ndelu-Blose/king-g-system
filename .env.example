# --- API (server / king-g-api on Vercel) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Same anon/publishable key as the frontend (for Auth sign-in on the API)
SUPABASE_ANON_KEY=your_supabase_anon_key
JWT_SECRET=change_me_in_production

# Resend (Supabase Auth SMTP + server welcome/reset emails)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@kinggeelfs.co.za
# Public app URL for auth email links (required in production)
APP_URL=https://king-g-system.vercel.app

# Sentry (API) — same project as frontend; never commit real tokens
# SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>

# --- Frontend (king-g-system on Vercel) ---
# Production: set VITE_API_URL to your API host (baked in at build time)
# VITE_API_URL=https://king-g-api.vercel.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# VITE_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>
# Source map upload on `npm run build` (also via .env.sentry-build-plugin — gitignored)
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=cliveux
# SENTRY_PROJECT=king-g-system

# Local dev: omit VITE_API_URL so Vite proxies /api → http://localhost:3001
